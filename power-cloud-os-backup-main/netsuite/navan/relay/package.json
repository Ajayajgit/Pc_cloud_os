{
  "name": "pc-navan-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Power Cloud Browser Relay - fetches Navan invoice PDFs via headless Chromium and posts them to NetSuite.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "uber-poll": "node src/uber-poll.js",
    "install-browser": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "otplib": "^12.0.1",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "playwright": "^1.50.0",
    "ssh2-sftp-client": "^11.0.0"
  }
}
