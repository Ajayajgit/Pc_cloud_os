# PC Navan Relay configuration. Copy to .env and fill in. On the VM, prefer
# pulling these from GCP Secret Manager at boot rather than committing a .env.

# --- Server ---
PORT=8787
# Shared bearer secret that NetSuite sends in the X-PC-Secret header.
# Must match custrecord_navan_relay_secret on the NS config record.
PC_RELAY_SECRET=

# --- Navan service account (interactive login automated by Playwright) ---
NAVAN_EMAIL=relay@powerclouderp.com
NAVAN_PASSWORD=
# If the service account has TOTP-based MFA, provide the base32 shared secret
# so the relay can generate codes. Leave blank if MFA is exempted via SSO.
NAVAN_TOTP_SECRET=

# --- NetSuite RESTlet (relay -> NS, Token-Based Auth / OAuth 1.0a) ---
NS_ACCOUNT_ID=5641465
NS_RESTLET_URL=https://5641465.restlets.api.netsuite.com/app/site/hosting/restlet.nl?script=customscript_pc_navan_invoice_attach&deploy=customdeploy_pc_navan_invoice_attach
NS_CONSUMER_KEY=
NS_CONSUMER_SECRET=
NS_TOKEN_ID=
NS_TOKEN_SECRET=

# --- Storage ---
DB_PATH=/var/lib/pc-navan-relay/relay.db

# --- Tuning ---
# Skip bookings created less than this many hours ago (give Navan time to
# materialize the invoice). Measured/tuned during Phase 2.
INVOICE_MIN_AGE_HOURS=2
PDF_WAIT_TIMEOUT_MS=30000
