[Unit]
Description=Paco private Chat Pub/Sub worker
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/powercloud-meeting-ingest
ExecStart=/opt/powercloud-meeting-ingest/venv/bin/python -m meeting_ingest.paco_worker --config /etc/powercloud/meeting-ingest/paco-config.json
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/powercloud-meeting-ingest/paco-state
TimeoutStartSec=5min
