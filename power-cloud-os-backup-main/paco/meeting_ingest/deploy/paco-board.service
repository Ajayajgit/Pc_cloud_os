[Unit]
Description=Paco weekly Asana board update (reads Asana, queues Chat posts)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/powercloud-meeting-ingest
ExecStart=/opt/powercloud-meeting-ingest/venv/bin/python -m meeting_ingest.paco_board --config /etc/powercloud/meeting-ingest/paco-config.json
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/powercloud-meeting-ingest/paco-state
TimeoutStartSec=20min
